{
  "name": "@doubleagent-so/core",
  "version": "0.1.0",
  "description": "Double Agent detection engine: classifies a browser session as human, bot or AI agent, entirely client-side.",
  "keywords": [
    "bot-detection",
    "ai-agent",
    "agent-detection",
    "browser-fingerprinting",
    "analytics"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doubleagent-so/core.git"
  },
  "homepage": "https://doubleagent.so/docs/",
  "bugs": "https://github.com/doubleagent-so/core/issues",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "bench": "node bench/run.ts",
    "size": "node scripts/size.mjs",
    "docs": "node scripts/docs.ts",
    "example": "node scripts/example.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
